# MedRec Environment Variables
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medrec?retryWrites=true&w=majority
PORT=5000

# Secret used to sign login tokens. Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: where uploaded report files are stored (relative to the project
# root) and the per-file size limit.
# UPLOADS_DIR=uploads/reports
# MAX_UPLOAD_MB=10
